---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Bernardo G. Erramuspe — Desarrollador full stack" } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imagenSocial = new URL("/og.jpg", Astro.site);
const googleAnalyticsId = import.meta.env.PUBLIC_GA_ID;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07060a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Bernardo G. Erramuspe" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bernardo G. Erramuspe, desarrollador full stack de Chivilcoy, Argentina" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/markdown" href="/index.md" title="Perfil en Markdown" />
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <Font cssVariable="--font-display" preload={[{ weight: 700, subset: "latin" }]} />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {
      googleAnalyticsId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`} />
          <script is:inline define:vars={{ googleAnalyticsId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { window.dataLayer.push(arguments); }
            gtag("js", new Date());
            gtag("config", googleAnalyticsId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <slot />
    <div class="fx-capa fx-scanlines" aria-hidden="true"></div>
    <div class="fx-capa fx-ruido" aria-hidden="true"></div>
    <div class="fx-capa fx-vineta" aria-hidden="true"></div>
  </body>
</html>
