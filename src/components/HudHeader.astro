---
// Barra superior del HUD: identificador del sistema, estado y reloj.
// El estado sale del horario semanal (src/data/horario.ts) en hora de
// Argentina: "En línea", "Ocupado · hasta 21:00" o, de noche, "Fuera de línea".
---

<header class="hud-superior mono">
  <span class="sistema">
    <img class="logo" src="/favicon.svg" width="30" height="30" alt="BG" />
    <span class="sistema-nombre">//PERFIL</span>
  </span>
  <span class="estado" data-estado="libre">
    <span class="punto" aria-hidden="true"></span>
    <span class="estado-texto">EN LÍNEA</span>
  </span>
  <time class="reloj" title="Hora en Chivilcoy">--:--:--</time>
</header>

<style>
  .hud-superior {
    display: flex;
    align-items: center;
    gap: 1rem 1.5rem;
    padding-block: 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--c-tenue);
    border-bottom: 1px solid var(--c-linea);
  }

  .sistema {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .logo {
    display: block;
    width: 30px;
    height: 30px;
    image-rendering: pixelated;
  }

  .estado {
    --c-estado: var(--c-verde);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: auto;
    text-transform: uppercase;
    color: var(--c-estado);
  }

  .estado[data-estado="ocupado"] {
    --c-estado: var(--c-rojo);
  }

  .estado[data-estado="fuera"] {
    --c-estado: var(--c-tenue);
  }

  .estado[data-estado="fuera"] .punto {
    box-shadow: none;
    animation: none;
  }

  .punto {
    width: 0.45rem;
    height: 0.45rem;
    background: var(--c-estado);
    box-shadow: 0 0 8px var(--c-estado);
    animation: latido 2.4s steps(1) infinite;
  }

  .reloj {
    min-width: 8ch;
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 30rem) {
    .reloj {
      display: none;
    }

    /* "Ocupado · hasta 21:00" tiene que entrar en un renglón. */
    .estado {
      white-space: nowrap;
      letter-spacing: 0.04em;
    }
  }

  /* En pantallas muy angostas queda solo el logo, para que entre el estado. */
  @media (max-width: 22.4rem) {
    .sistema-nombre {
      display: none;
    }
  }

  @keyframes latido {
    0%, 85% { opacity: 1; }
    90% { opacity: 0.2; }
    95% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .punto {
      animation: none;
    }
  }
</style>

<script>
  import { estadoActual, etiquetas, zonaHoraria } from "../data/horario";

  const reloj = document.querySelector<HTMLTimeElement>(".reloj");
  const estado = document.querySelector<HTMLElement>(".estado");
  const estadoTexto = document.querySelector<HTMLElement>(".estado-texto");

  const formato = new Intl.DateTimeFormat("es-AR", {
    timeZone: zonaHoraria,
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hourCycle: "h23",
  });

  const actualizar = () => {
    const ahora = new Date();
    if (reloj) reloj.textContent = formato.format(ahora);

    const { estado: actual, hasta } = estadoActual(ahora);
    const texto = hasta ? `${etiquetas[actual]} · hasta ${hasta}` : etiquetas[actual];
    if (!estado || !estadoTexto || estadoTexto.textContent === texto) return;
    estado.dataset.estado = actual;
    estadoTexto.textContent = texto;
  };

  actualizar();
  setInterval(actualizar, 1000);
</script>
