<!--
  BackgroundAnimation.astro
  Premium code-generated background replacing heavy video/gif assets (~9.4MB savings).
  - Layer 1: CSS animated gradient (zero JS, always active)
  - Layer 2: Canvas particle system (desktop only, disabled on mobile for performance)
  - Respects prefers-reduced-motion
-->

<div class="bg-animation-container" aria-hidden="true">
  <!-- Layer 1: Pure CSS animated gradient background -->
  <div class="bg-gradient-layer"></div>

  <!-- Layer 2: Canvas particles (desktop only) -->
  <canvas id="bg-particles-canvas" class="bg-canvas-layer"></canvas>

  <!-- Layer 3: Subtle noise/grain overlay for texture -->
  <div class="bg-noise-layer"></div>
</div>

<style>
  .bg-animation-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  /* Layer 1: Animated gradient — pure CSS, no JS cost */
  .bg-gradient-layer {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 80% 60% at 20% 80%, rgba(16, 185, 129, 0.08) 0%, transparent 70%),
      radial-gradient(ellipse 60% 80% at 80% 20%, rgba(34, 197, 94, 0.06) 0%, transparent 70%),
      radial-gradient(ellipse 100% 100% at 50% 50%, rgba(52, 211, 153, 0.03) 0%, transparent 60%),
      linear-gradient(160deg, #060d09 0%, #0a1510 25%, #0d1a14 50%, #081210 75%, #050b07 100%);
    background-size: 200% 200%, 200% 200%, 100% 100%, 100% 100%;
    animation: gradientShift 25s ease-in-out infinite alternate;
  }

  @keyframes gradientShift {
    0% {
      background-position: 0% 50%, 100% 0%, 50% 50%, 0% 0%;
    }
    25% {
      background-position: 30% 70%, 70% 30%, 50% 50%, 0% 0%;
    }
    50% {
      background-position: 60% 30%, 40% 60%, 50% 50%, 0% 0%;
    }
    75% {
      background-position: 80% 60%, 20% 80%, 50% 50%, 0% 0%;
    }
    100% {
      background-position: 100% 50%, 0% 100%, 50% 50%, 0% 0%;
    }
  }

  /* Layer 2: Canvas (transparent, positioned above gradient) */
  .bg-canvas-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0.7;
  }

  /* Layer 3: Noise texture via CSS for organic feel — extremely lightweight */
  .bg-noise-layer {
    position: absolute;
    inset: 0;
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 128px 128px;
    mix-blend-mode: overlay;
  }

  /* Subtle vignette overlay for depth */
  .bg-animation-container::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 40%, rgba(2, 8, 5, 0.5) 100%);
    pointer-events: none;
  }

  /* Mobile: hide canvas entirely for perf, rely on CSS gradient only */
  @media (max-width: 768px) {
    .bg-canvas-layer {
      display: none !important;
    }
  }

  /* Reduced motion: freeze the gradient, no canvas */
  @media (prefers-reduced-motion: reduce) {
    .bg-gradient-layer {
      animation: none;
    }
    .bg-canvas-layer {
      display: none !important;
    }
  }
</style>

<script>
  interface Particle {
    x: number;
    y: number;
    radius: number;
    speedY: number;
    speedX: number;
    opacity: number;
    opacityDirection: number;
    hue: number;
  }

  const initParticles = () => {
    const canvas = document.getElementById('bg-particles-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    // Skip on mobile (canvas is display:none via CSS, but also skip JS work)
    if (window.innerWidth < 768) return;

    // Skip if user prefers reduced motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let particles: Particle[] = [];
    let animationFrameId: number;
    let isVisible = true;

    // Pre-render a single soft circle to an offscreen canvas for GPU-friendly drawing
    const offscreen = document.createElement('canvas');
    const oCtx = offscreen.getContext('2d');
    const SPRITE_SIZE = 64;
    offscreen.width = SPRITE_SIZE;
    offscreen.height = SPRITE_SIZE;

    const renderSprite = () => {
      if (!oCtx) return;
      oCtx.clearRect(0, 0, SPRITE_SIZE, SPRITE_SIZE);
      const half = SPRITE_SIZE / 2;
      const grad = oCtx.createRadialGradient(half, half, 0, half, half, half);
      grad.addColorStop(0, 'rgba(180, 220, 200, 0.25)');
      grad.addColorStop(0.4, 'rgba(140, 200, 170, 0.12)');
      grad.addColorStop(1, 'rgba(100, 180, 150, 0)');
      oCtx.fillStyle = grad;
      oCtx.beginPath();
      oCtx.arc(half, half, half, 0, Math.PI * 2);
      oCtx.fill();
    };

    const setSize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const createParticle = (scatter = false): Particle => {
      const radius = Math.random() * 6 + 2;
      return {
        x: Math.random() * width,
        y: scatter ? Math.random() * height : height + radius + Math.random() * 80,
        radius,
        speedY: -(Math.random() * 0.35 + 0.1),
        speedX: (Math.random() - 0.5) * 0.15,
        opacity: Math.random() * 0.6 + 0.2,
        opacityDirection: Math.random() > 0.5 ? 1 : -1,
        hue: 140 + Math.random() * 30, // green spectrum
      };
    };

    const PARTICLE_COUNT = Math.min(Math.floor(width / 45), 40);

    const init = () => {
      setSize();
      renderSprite();
      particles = [];
      for (let i = 0; i < PARTICLE_COUNT; i++) {
        particles.push(createParticle(true));
      }
    };

    const draw = () => {
      if (!isVisible) {
        animationFrameId = requestAnimationFrame(draw);
        return;
      }

      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];

        // Subtle opacity breathing
        p.opacity += p.opacityDirection * 0.002;
        if (p.opacity >= 0.8) { p.opacity = 0.8; p.opacityDirection = -1; }
        if (p.opacity <= 0.15) { p.opacity = 0.15; p.opacityDirection = 1; }

        const drawSize = p.radius * 4;
        ctx.globalAlpha = p.opacity;
        ctx.drawImage(offscreen, p.x - drawSize / 2, p.y - drawSize / 2, drawSize, drawSize);

        // Move
        p.y += p.speedY;
        p.x += p.speedX;

        // Reset when off-screen
        if (p.y < -drawSize) {
          Object.assign(p, createParticle(false));
        }
        // Wrap horizontally
        if (p.x < -drawSize) p.x = width + drawSize;
        if (p.x > width + drawSize) p.x = -drawSize;
      }

      ctx.globalAlpha = 1;
      animationFrameId = requestAnimationFrame(draw);
    };

    // Pause rendering when tab is not visible
    const handleVisibility = () => {
      isVisible = !document.hidden;
    };

    // Debounced resize
    let resizeTimer: ReturnType<typeof setTimeout>;
    const handleResize = () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        if (window.innerWidth < 768) {
          cancelAnimationFrame(animationFrameId);
          return;
        }
        setSize();
        // Re-seed particles for new dimensions
        particles = [];
        const newCount = Math.min(Math.floor(width / 45), 40);
        for (let i = 0; i < newCount; i++) {
          particles.push(createParticle(true));
        }
      }, 200);
    };

    // Theme change — update sprite colors
    const themeObserver = new MutationObserver(() => {
      renderSprite();
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    // Start
    init();
    draw();

    document.addEventListener('visibilitychange', handleVisibility);
    window.addEventListener('resize', handleResize);

    return () => {
      cancelAnimationFrame(animationFrameId);
      themeObserver.disconnect();
      document.removeEventListener('visibilitychange', handleVisibility);
      window.removeEventListener('resize', handleResize);
      clearTimeout(resizeTimer);
    };
  };

  let cleanup: (() => void) | undefined;

  const runBg = () => {
    if (cleanup) cleanup();
    cleanup = initParticles();
  };

  runBg();
  document.addEventListener('astro:after-swap', runBg);
</script>
