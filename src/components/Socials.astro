---
import portfolioData from "../data/portfolio.json";

const { github, linkedin, instagram, facebook, steam, xbox, youtube } = portfolioData.personalInfo;

const groups = [
  {
    title: "Perfiles",
    links: [
      { name: "GitHub", url: github, icon: "fab fa-github", brand: "github" },
      { name: "LinkedIn", url: linkedin, icon: "fab fa-linkedin-in", brand: "linkedin" },
      { name: "Instagram", url: instagram, icon: "fab fa-instagram", brand: "instagram" },
      { name: "Facebook", url: facebook, icon: "fab fa-facebook-f", brand: "facebook" },
    ],
  },
  {
    title: "Streaming",
    links: [
      { name: "Kick", url: "https://kick.com/bernardtw2806", icon: "", brand: "kick" },
      { name: "YouTube", url: youtube || "https://www.youtube.com/@bernardtw2806", icon: "fab fa-youtube", brand: "youtube" },
      { name: "Twitch", url: "https://www.twitch.tv/bernardtw2806", icon: "fab fa-twitch", brand: "twitch" },
    ],
  },
  {
    title: "Gaming",
    links: [
      { name: "Steam", url: steam, icon: "fab fa-steam", brand: "steam" },
      { name: "Xbox", url: xbox, icon: "fab fa-xbox", brand: "xbox" },
    ],
  },
];
---

<div class="panel-socials">
  {groups.map((group) => (
    <section class="socials-group" aria-label={group.title}>
      {group.title !== "Perfiles" && <h3 class="socials-group-title">{group.title}</h3>}
      <ul class="socials-list">
        {group.links.map((social) => (
          <li>
            <a href={social.url} target="_blank" rel="noopener noreferrer" class={`social-link brand-${social.brand}`}>
              <span class="social-link-icon">
                {social.brand === "kick" ? (
                  <svg viewBox="0 0 512 512" fill="currentColor" class="kick-svg" aria-hidden="true">
                    <path d="M37 .036h164.448v113.621h54.71v-56.82h54.731V.036h164.448v170.777h-54.73v56.82h-54.711v56.8h54.71v56.82h54.73V512.03H310.89v-56.82h-54.73v-56.8h-54.711v113.62H37V.036z"/>
                  </svg>
                ) : (
                  <i class={social.icon} aria-hidden="true"></i>
                )}
              </span>
              <span class="social-link-name">{social.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .panel-socials {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
  }

  .socials-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .socials-group-title {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  /* Lista densa: cada red es una fila con ícono y nombre */
  .socials-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.5rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: rgba(14, 26, 21, 0.6);
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.92rem;
    transition: border-color var(--transition-speed) ease, background-color var(--transition-speed) ease;
  }

  .social-link-icon {
    width: 1.5rem;
    display: flex;
    justify-content: center;
    font-size: 1.1rem;
    color: var(--text-muted);
    transition: color var(--transition-speed) ease;
  }

  .kick-svg {
    width: 15px;
    height: 15px;
  }

  .social-link:hover {
    background-color: var(--bg-hover);
    border-color: var(--brand, var(--accent-teal));
  }

  .social-link:hover .social-link-icon {
    color: var(--brand, var(--accent-teal));
  }

  /* Color de marca, solo al pasar el mouse o enfocar */
  .brand-github    { --brand: #ffffff; }
  .brand-linkedin  { --brand: #3b8fe0; }
  .brand-instagram { --brand: #e1306c; }
  .brand-facebook  { --brand: #3b8bf5; }
  .brand-kick      { --brand: #53fc18; }
  .brand-youtube   { --brand: #ff3b3b; }
  .brand-twitch    { --brand: #a970ff; }
  .brand-steam     { --brand: #66c0f4; }
  .brand-xbox      { --brand: #2fb52f; }

  .social-link:focus-visible .social-link-icon {
    color: var(--brand, var(--accent-teal));
  }
</style>
