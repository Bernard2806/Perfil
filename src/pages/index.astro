---
import Layout from "../layouts/Layout.astro";
import GlitchPortrait from "../components/GlitchPortrait.astro";
import GlitchText from "../components/GlitchText.astro";
import HudFooter from "../components/HudFooter.astro";
import HudHeader from "../components/HudHeader.astro";
import MainMenu from "../components/MainMenu.astro";
import RolRotativo from "../components/RolRotativo.astro";
import WebMcp from "../components/WebMcp.astro";
import { perfil } from "../data/site";

---

<Layout title={`${perfil.nombreVisible} · ${perfil.rol}`} description={perfil.descripcion}>
  <div class="pantalla arranque">
    <HudHeader />

    <main class="escena">
      <div class="identidad">
        <p class="etiqueta mono">// UBICACIÓN · {perfil.ubicacion}</p>
        <h1 class="nombre">
          <GlitchText texto={`${perfil.nombre} ${perfil.inicial}`} pausaMin={3400} pausaMax={7000} />
          <GlitchText texto={perfil.apellido} />
        </h1>
        <p class="rol mono">
          <span aria-hidden="true">&gt; </span><RolRotativo roles={perfil.roles} /><span class="cursor" aria-hidden="true">_</span>
        </p>
      </div>

      <div class="visor">
        <GlitchPortrait alt={`Foto de ${perfil.nombreVisible}`} alias={perfil.alias} />
      </div>

      <div class="navegacion">
        <MainMenu />
      </div>
    </main>

    <HudFooter />
  </div>
  <WebMcp />
</Layout>

<style>
  .pantalla {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100dvh;
    max-width: 78rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .escena {
    display: grid;
    grid-template-areas:
      "identidad"
      "visor"
      "navegacion";
    gap: 2.25rem;
    align-content: center;
    padding-block: 2.5rem;
  }

  @media (min-width: 56rem) {
    .escena {
      grid-template-columns: 1.25fr 0.85fr;
      grid-template-areas:
        "identidad visor"
        "navegacion visor";
      column-gap: clamp(2rem, 5vw, 4.5rem);
      row-gap: 2.5rem;
      align-items: center;
    }
  }

  .identidad {
    grid-area: identidad;
  }

  .visor {
    grid-area: visor;
  }

  .navegacion {
    grid-area: navegacion;
  }

  @media (max-width: 55.99rem) {
    .visor {
      max-width: 20rem;
      width: 100%;
      margin-inline: auto;
    }
  }

  .etiqueta {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-verde);
  }

  .nombre {
    display: grid;
    margin: 0;
    font-size: clamp(2rem, 10vw, 6rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--c-texto);
  }

  /* El segundo apellido es lo que más resalta. */
  .nombre :global(glitch-text:last-child) {
    color: var(--c-rojo);
    text-shadow: 0 0 28px rgb(252 1 71 / 0.35);
  }

  .rol {
    margin: 1rem 0 0;
    font-size: clamp(0.95rem, 2.4vw, 1.1rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--c-texto);
  }

  .cursor {
    color: var(--c-verde);
    animation: parpadeo 1s steps(1) infinite;
  }

  @keyframes parpadeo {
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  /* Pantallas anchas: nombre y menú a la izquierda, panel al medio y foto a
     la derecha, como la pantalla de personaje de un juego. */
  @media (min-width: 80rem) {
    .escena {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.1fr) minmax(0, 0.75fr);
      grid-template-areas:
        "identidad panel visor"
        "lista panel visor";
      column-gap: clamp(1.5rem, 3vw, 3rem);
      row-gap: 2rem;
    }

    .navegacion {
      display: contents;
    }

    .nombre {
      font-size: clamp(3rem, 4.2vw, 4.75rem);
    }
  }

  @media (min-width: 56rem) and (max-width: 79.99rem) {
    .nombre {
      font-size: clamp(3rem, 5.5vw, 5rem);
    }
  }

  /* "> Analista en ciberseguridad_" tiene que entrar en un renglón. */
  @media (max-width: 30rem) {
    .rol {
      font-size: 0.85rem;
      letter-spacing: 0.06em;
    }
  }
</style>
